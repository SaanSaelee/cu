      <!-- Shared SFMC Learner Header Button Version BEGIN -->
      %%=ContentBlockbyId("101723")=%%
      <!-- Shared SFMC Learner Header Button Version END -->
      <!-- Standard hero / photo small BEGIN -->
    </mj-raw>

    <!-- BEGIN CU 2026 Brand SFMC App Shared Header -->
    <Mj-raw>%%[
 
IF empty(@url_1) THEN
  SET @applylink = "https://apply.capella.edu"
ELSE
  SET @applyLink = concat(@url_1, @prefix, @cid_1, @emailid, @campname)
ENDIF
 
IF empty(@url_2) THEN
  SET @connectwithus = "https://www.capella.edu/contact-enrollment/"
ELSE
  SET @connectwithus = concat(@url_2, @prefix, @cid_1, @emailid, @campname)
ENDIF
 
IF empty(@url_3) THEN
  SET @VClink = "https://www.capella.edu/"
ELSE
  SET @VClink = concat(@url_3, @prefix, @cid_1, @emailid, @campname)
ENDIF
 
IF empty(@url_4) THEN
  SET @Employer = "https://www.capella.edu/tuition-financial-aid/employer-assistance/"
ELSE
  SET @Employer = concat(@url_4, @prefix, @cid_1, @emailid, @campname)
ENDIF 
 
]%%</Mj-raw>
      
    <mj-section padding="10px 0px 10px" css-class="navcenter" background-color="#000000" background-url="https://image.learner.capella.edu/lib/fe3411717164047a751076/m/1/4fc742ba-041a-4a7f-8645-d812a372ff81.jpg">
      <mj-group width="50%">
        <mj-column width="9%" vertical-align="middle" css-class="mhidden">
        </mj-column>
        <mj-column width="91%" vertical-align="middle" css-class="mnavlogo ">
          <mj-image css-class="mobile-logo" alt="Capella University" href="%%=v(@VClink)=%%" width="200px" height="46px" align="left" padding="0px" src="https://image.learner.capella.edu/lib/fe3411717164047a751076/m/1/be19a764-769f-493e-8321-da0d09d10f98.png" />
        </mj-column>
      </mj-group>
      <mj-group width="50%">
        <mj-column vertical-align="middle" padding="10px 8px 10px 18px">
        <mj-button css-class="hovered nav-nowrap" padding="0" align="right" background-color="#FFFFFF" color="#000000" border="2px #FFFFFF solid" inner-padding="9px 31px 9px" href="%%=v(@applyLink)=%%">My App</mj-button>
        </mj-column>
        <mj-column width="50%" vertical-align="middle" padding="10px 18px 10px 8px">
          <mj-button css-class="ghostbtn nav-nowrap" padding="0" align="left" color="#FFFFFF" background-color="#000000" border="2px #FFFFFF solid" border-radius="30px" inner-padding="9px 18px 9px" href="%%=v(@connectwithus)=%%">Contact&nbsp;us</mj-button>
        </mj-column>
      </mj-group>
    </mj-section>
    <!-- END CU 2026 Brand SFMC App Shared Header -->

    <!-- Hero with a transparent star + headline BEGIN -->
    <mj-section background-color="#000000">
      <mj-column>
        <mj-image padding="0" alt="Portrayal of Capella nursing student studying
for online classes." src="https://image.learner.capella.edu/lib/fe3411717164047a751076/m/1/4a3b9669-2d28-4f95-8ea5-1048177f0424.png"></mj-image>
      </mj-column>
    </mj-section>
    <!-- Part 1 END -->
    <!--  Part 2 BEGIN -->
    <mj-section background-color="#000000" padding="0px">
      <mj-group>
      <mj-column width="91%">
       <mj-text color="#FFFFFF" padding="0px 25px 15px">                   
         <h2>Start your master’s sooner</h2>          
        </mj-text>
      </mj-column>
      <mj-column width="9%" css-class="mhidden">
       <mj-text color="#FFFFFF" padding="0px 25px 30px">                   
         <h2>&nbsp;</h2>          
        </mj-text>
      </mj-column>
      </mj-group>
    </mj-section>
    <!-- End  Hero with a transparent star + headline --> 


    <!-- BEGIN C-2.0 Copy block with single primary CTA -->
     <mj-section css-class="text-box">
      <mj-column css-class="hyphenation">
        <mj-text>
          <p style="text-transform:capitalize;">Hi %%Preferred_Name__c%%,</p>
          <p>You know what you’re reaching for in your career. Earn a degree that helps you reach it.</p>
          <p>Capella’s Accelerated Master’s Pathway (AMP) lets you take master’s-level courses in select bachelor’s programs – so you can keep your momentum while potentially saving time and money on a future master’s degree.  </p>
          <p style="margin-bottom:0;">You’ve already started your application for an AMP-eligible program. Now take the next step. </p>
        </mj-text>        
        <mj-button css-class="hovered" href="https://apply.capella.edu/login/?seicid=d45c01df00ed4d1db8b2b2e71c1c9a80" align="left" padding="10px 25px 30px"> Finish your application </mj-button> 
      </mj-column>
    </mj-section>
  <!-- C-2.0 Copy block with single primary CTA END -->

      <!-- BEGIN Section Headline -->
    <mj-section padding="0" background-color="#F0F0EF" css-class="text-box">
      <mj-column>
        <mj-text align="center" padding="40px 25px 0px">
          <h3>Frequently asked questions</h3> 
        </mj-text>     
      </mj-column>
    </mj-section>
    <!-- Icon Section Headline END -->  

    <!--  BEGIN Secondaries: Rounded Card on Grey, left aligned -->     
    <mj-wrapper background-color="#F0F0EF" padding="15px 25px 5px">
      <mj-section background-color="#FFFFFF" border-radius="24px" padding="15px 0 20px">
        <mj-column>
            <mj-text>
              <h5>Why AMP?</h5>
              <p style="margin-bottom:10px;">Qualifying courses from an AMP-eligible bachelor’s program can be applied toward a future master’s program, potentially saving you time and money.</p>
            </mj-text>
          </mj-column>      
      </mj-section>
    </mj-wrapper>
  <!-- End Secondaries: Rounded Card on Grey, left aligned -->
    <!--  BEGIN Secondaries: Rounded Card on Grey, left aligned -->     
    <mj-wrapper background-color="#F0F0EF" padding="15px 25px 5px">
      <mj-section background-color="#FFFFFF" border-radius="24px" padding="15px 0 20px">
        <mj-column>
            <mj-text>
              <h5>Do AMP programs cost more?</h5>
              <p style="margin-bottom:10px;">There’s no additional cost to enroll in an AMP-eligible bachelor’s program.</p>
            </mj-text>
          </mj-column>      
      </mj-section>
    </mj-wrapper>
  <!-- End Secondaries: Rounded Card on Grey, left aligned -->
    <!--  BEGIN Secondaries: Rounded Card on Grey, left aligned -->     
    <mj-wrapper background-color="#F0F0EF" padding="15px 25px 25px">
      <mj-section background-color="#FFFFFF" border-radius="24px" padding="15px 0 20px">
        <mj-column>
            <mj-text>
              <h5>Is grading the same for AMP and non-AMP degrees? </h5>
              <p style="margin-bottom:10px;">AMP has specific academic requirements to stay in the program. If you don’t meet them, you’ll transition to the standard bachelor’s program.</p>
            </mj-text>
          </mj-column>      
      </mj-section>
    </mj-wrapper>
  <!-- End Secondaries: Rounded Card on Grey, left aligned -->

      <!--  BEGIN Secondaries: Rounded Grey Card, center aligned, 3 CTA options --> 
     <mj-section background-color="#FFFFFF" padding="25px 25px 15px" css-class="text-box">
      <mj-column vertical-align="top" css-class="hyphenation" background-color="#707070" border-radius="24px">
       <mj-text padding="28px 6% 5px" align="center">
         <h3 style="color:#FFFFFF;">Questions? Let’s tackle them.</h3>
        </mj-text>            
        <mj-button css-class="ghostbtn" border="2px #000000 solid" color="#000000" background-color="#FFFFFF" border-radius="30px" href="https://www.capella.edu/contact-enrollment/?seicid=d45c01df00ed4d1db8b2b2e71c1c9a80" align="center" padding="2px 0 5px" name="project#_EM#_2B_Button" inner-padding="8px 25px">Contact enrollment</mj-button>
        <mj-spacer height="25px" />    
      </mj-column>      
    </mj-section>
    <!--  END Secondaries: Rounded Grey Card, center aligned, 3 CTA options -->    

       <mj-raw>
      <!-- SFMC HTML Track Opens BEGIN -->
      <custom name="opencounter" type="tracking" > </custom>
      <custom name="usermatch" type="tracking" ></custom>
      <!--SFMC HTML Track Opens END -->
      
