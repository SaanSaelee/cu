    </mj-raw>
  </mj-head>
  <mj-body background-color="#FFFFFF">
    <!-- C-1.1 Eloqua Preheader BEGIN -->
    <mj-section css-class="mhidden" padding="0px">
      <mj-group>
        <mj-column width="60%">
          <mj-text align="left" font-size="12px" line-height="18px" color="#53565A"><a style="font-family: arial,sans-serif;font-weight:normal;text-decoration:underline;color:#53565A" href="https://www.capella.edu/capella-experience/competency-based-education/?seicid=933b5b82c43c4f56a8c582bb55b38a57"><span style="font-family: arial,sans-serif;color:#53565A;font-weight:normal;text-decoration:underline;">Put your skills to work</span></a>.</mj-text>
        </mj-column>
        <mj-column width="40%">
          <mj-text align="right" font-size="12px" line-height="18px" color="#53565A">
            <a style="color:#939598;font-weight:normal;text-decoration:underline;" href="https://app.elqassets.strategiced.com/e/es?s=~~eloqua..type--emailfield..syntax--siteid..encodeFor--url~~&e=~~eloqua..type--emailfield..syntax--elqemailsaveguid..encodeFor--url~~"><span style="color:#53565A;font-weight:normal;text-decoration:underline;">View in browser</span></a>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>  
      <!-- C-1.1 Preheader END -->      
   <mj-raw>
      <!-- Shared Eloqua Prospect Header BEGIN -->
      <span elqid="1544" elqtype="Section" class="remove-absolute" style="display: block"></span>
      <!-- Shared Eloqua Prospect Header END -->

     </mj-raw>         
    <!-- Standard hero BEGIN -->
    <mj-section>
      <mj-column>
        <mj-image padding="0" href="https://apply.capella.edu/?seicid=933b5b82c43c4f56a8c582bb55b38a57" alt="Portrayal of a Capella University online business
student studying on his laptop in a cafe." src="https://images.elqassets.strategiced.com/EloquaImages/clients/SEIEloqua/%7B0af756f5-0026-4d37-af7d-f71da6acef48%7D_2302792_EM9_600x350_1x.png"></mj-image>
      </mj-column>
    </mj-section>
    <!-- Standard hero END -->
    <!-- BEGIN C-2.0 Copy block with single primary CTA -->
     <mj-section padding-top="20px">
      <mj-column css-class="hyphenation">
        <mj-text>          
          <h2>Got skills? Put them to work.</h2>
          <p>You’ve got real-world experience – use it for a head start on your degree. </p>
          <p style="margin-top:10px;margin-bottom:10px;">At Capella, you won’t waste time memorizing facts just to pass a test. Through competency-based assessments, you advance by showing you can apply your skills to actual workplace challenges.</p>          
        </mj-text>        
        <mj-button css-class="hovered" href="https://www.capella.edu/capella-experience/competency-based-education/?seicid=933b5b82c43c4f56a8c582bb55b38a57" align="left" padding="0px 25px 25px">See how CBE works</mj-button> 
      </mj-column>
    </mj-section>
    <!-- C-2.0 Copy block with single primary CTA END -->
    <!--  BEGIN Secondaries: Rounded Grey Card, center aligned, 3 CTA options --> 
     <mj-section background-color="#FFFFFF" padding="5px 25px 30px" css-class="text-box">
      <mj-column vertical-align="top" css-class="hyphenation" background-color="#EBEBEB" border-radius="24px">
       <mj-text padding="28px 6% 5px" align="center">
         <h3>Fast-track your progress</h3>
         <p style="margin-top:13px;margin-bottom:13px;">See how your background can help you move through courses faster. Talk to an enrollment specialist today.</p>
        </mj-text>            
        <mj-button css-class="ghostbtn" border="2px #C10016 solid" color="#C10016" background-color="#FFFFFF" border-radius="30px" href="https://www.capella.edu/contact-enrollment/?seicid=933b5b82c43c4f56a8c582bb55b38a57" align="center" padding="0px 0 5px" name="project#_EM#_2B_Button" inner-padding="8px 25px">Let’s connect</mj-button> 
        <mj-spacer height="25px" />    
      </mj-column>      
    </mj-section>
    <!--  END Secondaries: Rounded Grey Card, center aligned, 3 CTA options -->       
  </mj-body>
</mjml>