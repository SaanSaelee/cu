  <!-- QA_VARIANT: INITIAL -->
  <!-- SUBJECT: Still interested in a Capella degree? -->    
    </mj-raw>
  </mj-head>
  <mj-body background-color="#FFFFFF">  
    <!-- C-1.1 Eloqua Preheader BEGIN -->
    <mj-section css-class="mhidden" padding="0px">
      <mj-group> 
        <mj-column width="60%">
          <mj-text align="left" font-size="12px" line-height="18px" color="#53565A"><a style="font-family: arial,sans-serif;font-weight:normal;text-decoration:underline;color:#53565A" href="https://www.capella.edu/tuition-financial-aid/scholarships-grants/?seicid=2633f9f22ca946c9a01f3b0fd01dc1c5"><span style="font-family: arial,sans-serif;color:#53565A;font-weight:normal;text-decoration:underline;">Find ways to save on your Capella degree</span></a>.</mj-text>
        </mj-column>
        <mj-column width="40%">
          <mj-text align="right" font-size="12px" line-height="18px" color="#53565A">
            <a style="color:#939598;font-weight:normal;text-decoration:underline;" href="https://app.elqassets.strategiced.com/e/es?s=~~eloqua..type--emailfield..syntax--siteid..encodeFor--url~~&e=~~eloqua..type--emailfield..syntax--elqemailsaveguid..encodeFor--url~~"><span style="color:#53565A;font-weight:normal;text-decoration:underline;">View in browser</span></a>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>  
      <!-- C-1.1 Preheader END -->
      
    <mj-raw>
      <!-- Shared Eloqua Prospect Header BEGIN -->
      <span elqid="1544" elqtype="Section" class="remove-absolute" style="display: block"></span>
      <!-- Shared Eloqua Prospect Header END -->
    </mj-raw>
         
    <!-- Standard hero BEGIN -->
    <mj-section>
      <mj-column>
        <mj-image padding="0" alt="Portrayal of Capella online student seated at a desk and taking notes." src="https://images.elqassets.strategiced.com/EloquaImages/clients/SEIEloqua/%7Bb0ae8613-0707-40c6-b05e-c6e62a3b40ea%7D_2276000_EM2_Hero_600x350_1x.png"></mj-image>
      </mj-column>
    </mj-section>
    <!-- Standard hero END -->

       <!-- BEGIN C-2.0 Copy block with single primary CTA -->
    <mj-section>
      <mj-column>
        <mj-text padding-top="20px" >
          <h2>Your goals are still within reach</h2>
          <p>Hi <span class=eloquaemail >CU_Prospect_First_Name1</span>,</p>
          <p>We saw you stepped away from your application, but you started for a reason. </p>
          <p>Your degree isn’t just about today – it’s about building what comes next. At Capella, we’ll help you find affordable ways to keep moving forward. </p>
          <p style="margin-top:13px;margin-bottom:0px;">Your goals are still there. So is your next step.</p>
        </mj-text>
        <mj-button css-class="hovered" href="https://apply.capella.edu/?seicid=2633f9f22ca946c9a01f3b0fd01dc1c5" align="left" padding="8px 25px 25px"> Reapply today </mj-button> 
      </mj-column>
    </mj-section>
    <!-- C-2.0 Copy block with single primary CTA END -->

    <!--  BEGIN Secondaries: Rounded Card on White, center aligned --> 
     <mj-section background-color="#FFFFFF" padding="10px 25px 25px" css-class="text-box">
      <mj-column padding="28px 10px 25px" vertical-align="top" css-class="hyphenation" background-color="#EBEBEB" border-radius="24px">
       <mj-text padding="0 3%" align="center">
         <h3>Experience it for yourself</h3>
        </mj-text>
        <mj-text padding="0 5%" align="left">         
          <p style="margin-top:10px;margin-bottom:0px;">Preview the Capella experience with <a style="color:#C10016;text-decoration:underline !important;" href="https://www.capella.edu/capella-experience/trial-course-registration/?seicid=2633f9f22ca946c9a01f3b0fd01dc1c5" target="_blank">our trial course</a> to see how you’ll communicate with faculty, submit coursework and more. </p>        
        </mj-text>
      </mj-column>      
    </mj-section>
    <!--  END Secondaries: Rounded Card on White, center aligned -->  

  </mj-body>
</mjml>